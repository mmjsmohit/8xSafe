{
  "name": "@call-screener/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint src test drizzle.config.ts vitest.config.ts",
    "start": "node dist/server.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "worker": "tsx watch src/worker.ts"
  },
  "dependencies": {
    "@call-screener/contracts": "0.1.0",
    "@elevenlabs/elevenlabs-js": "^2.65.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.3.0",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "fastify-plugin": "^5.0.1",
    "fastify-raw-body": "^5.0.0",
    "libphonenumber-js": "^1.12.18",
    "openai": "^7.8.0",
    "pg": "^8.16.3",
    "twilio": "^5.10.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
}
