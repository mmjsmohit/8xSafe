{
  "name": "@call-screener/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "build": "expo export --platform all --output-dir dist",
    "export": "expo export --platform android --output-dir dist/android",
    "lint": "eslint app src",
    "start": "expo start --dev-client",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@call-screener/contracts": "0.1.0",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.102.8",
    "expo": "~57.0.18",
    "expo-audio": "~57.0.4",
    "expo-constants": "~57.0.16",
    "expo-dev-client": "~57.0.16",
    "expo-linking": "~57.0.8",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.87.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "react-native-web": "~0.21.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.2.18",
    "vitest": "^3.2.4"
  }
}
